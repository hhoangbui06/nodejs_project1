extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(5000)

  .container.my-3
    .row
      .col-12
        +box-head(title)

    if(order)
      .row
        .col-md-4.mb-3
          .card
            .card-header
              b Thông tin người nhận
            .card-body
              p
                b Họ tên:
                |  #{order.userInfo && order.userInfo.fullName || "Không xác định"}
              p
                b Số điện thoại:
                |  #{order.userInfo && order.userInfo.phone || ""}
              p
                b Địa chỉ:
                |  #{order.userInfo && order.userInfo.address || ""}
              p
                b Ngày đặt:
                |  #{order.createdAt ? new Date(order.createdAt).toLocaleDateString('vi-VN') : ""}

        .col-md-8.mb-3
          .card
            .card-header
              b Chi tiết sản phẩm
            .card-body.p-0
              table.table.table-bordered.mb-0
                thead
                  tr
                    th.text-center STT
                    th Sản phẩm
                    th.text-center Đơn giá
                    th.text-center Số lượng
                    th.text-right Tổng tiền
                tbody
                  if(order.products && order.products.length > 0)
                    each item, index in order.products
                      tr
                        td.text-center #{index + 1}
                        td
                          .d-flex.align-items-center
                            if item.productInfo && item.productInfo.thumbnail
                              img(src=item.productInfo.thumbnail alt="" style="width:50px;height:50px;object-fit:cover;margin-right:10px;border-radius:4px")
                            if item.productInfo && item.productInfo.title
                              span #{item.productInfo.title}
                            else
                              em.text-muted Sản phẩm không còn tồn tại
                        td.text-center #{item.priceNew} $
                        td.text-center #{item.quantity}
                        td.text-right
                          b #{item.totalPrice} $
                  else
                    tr
                      td(colspan="5")
                        .text-center.py-3 Không có sản phẩm nào
              if(order.products && order.products.length > 0)
                .card-footer.text-right
                  h5
                    | Tổng đơn hàng:
                    b.text-danger  #{order.totalPrice} $

    .text-center.mt-3
      a.btn.btn-outline-secondary(href="/orders") Quay lại danh sách đơn hàng
