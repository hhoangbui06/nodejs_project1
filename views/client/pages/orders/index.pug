extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(5000)

  .container.my-3
    .row
      .col-12
        +box-head(title)
    .row
      .col-12
        if(orders.length > 0)
          table.table.table-bordered
            thead
              tr
                th.text-center STT
                th Người nhận
                th.text-center Số sản phẩm
                th.text-right Tổng tiền
                th Ngày đặt
                th.text-center Hành động
            tbody
              each order, index in orders
                tr
                  td.text-center #{index + 1}
                  td #{order.userInfo && order.userInfo.fullName || "Khong xac dinh"}
                  td.text-center #{order.products && order.products.length || 0}
                  td.text-right
                    b #{order.totalPrice || 0} $
                  td
                    if order.createdAt
                      | #{new Date(order.createdAt).toLocaleDateString('vi-VN')}
                  td.text-center
                    a.btn.btn-info.btn-sm(href=`/orders/detail/${order._id}`) Chi tiết
        else
          .text-center.py-4
            h4 Bạn chưa có đơn hàng nào!
            a.btn.btn-primary.mt-2(href="/products") Mua sắm ngay

    .text-center.mt-3
      a.btn.btn-outline-secondary(href="/cart") Quay lại giỏ hàng
