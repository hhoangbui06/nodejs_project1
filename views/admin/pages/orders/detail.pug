extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/formatDateTime.pug

block main
  +alert-success(3000)
  +alert-error(5000)

  .admin-order-page
    if order
      .admin-order-header
        h1.admin-order-title  Chi tiết đơn hàng
        .admin-order-id ##{order._id}

      .row
        //- Thông tin khách hàng
        .col-md-5.mb-3
          .admin-order-card
            .admin-order-card-header
              span Thông tin khách hàng
            .admin-order-card-body
              .admin-detail-item
                .admin-detail-label Họ tên
                .admin-detail-value #{order.userInfo && order.userInfo.fullName || "Không xác định"}
              .admin-detail-item
                .admin-detail-label Số điện thoại
                .admin-detail-value #{order.userInfo && order.userInfo.phone || ""}
              .admin-detail-item
                .admin-detail-label Địa chỉ
                .admin-detail-value #{order.userInfo && order.userInfo.address || ""}
              .admin-detail-item
                .admin-detail-label Ngày đặt hàng
                .admin-detail-value
                  +formatDateTime(order.createdAt)

        //- Tổng quan
        .col-md-7.mb-3
          .admin-order-card
            .admin-order-card-header
              span  Tổng quan đơn hàng
            .admin-order-card-body
              .admin-summary-grid
                .admin-summary-item
                  .summary-number #{order.products ? order.products.length : 0}
                  .summary-label Sản phẩm
                .admin-summary-item
                  .summary-number #{order.totalPrice || 0} $
                  .summary-label Tổng tiền
                .admin-summary-item
                  .summary-number
                    +formatDate(order.createdAt)
                  .summary-label Ngày tạo

      //- Danh sách sản phẩm
      .admin-order-card.mb-3
        .admin-order-card-header
          span  Danh sách sản phẩm
        .admin-order-card-body.p-0
          if order.products && order.products.length > 0
            .table-responsive
              table.table.table-sm
                thead
                  tr
                    th.text-center STT
                    th Sản phẩm
                    th.text-center Giá gốc
                    th.text-center Giảm giá
                    th.text-center Giá sau giảm
                    th.text-center Số lượng
                    th.text-right Thành tiền
                tbody
                  each item, index in order.products
                    tr
                      td.text-center #{index + 1}
                      td
                        .admin-product-cell
                          if item.productInfo && item.productInfo.thumbnail
                            .admin-product-thumb
                              img(src=item.productInfo.thumbnail alt=item.productInfo.title || "")
                          else
                            .admin-product-thumb.placeholder 
                          .admin-product-name
                            if item.productInfo && item.productInfo.title
                              | #{item.productInfo.title}
                            else
                              em.text-muted Sản phẩm không tồn tại
                      td.text-center #{item.price} $
                      td.text-center
                        span.badge.badge-warning #{item.discountPercentage}%
                      td.text-center
                        b #{item.priceNew} $
                      td.text-center #{item.quantity}
                      td.text-right
                        b #{item.totalPrice} $
                tfoot
                  tr
                    td(colspan="6" class="text-right")
                      strong Tổng tiền:
                    td.text-right
                      strong.order-total #{order.totalPrice} $
          else
            .admin-order-empty
              p Không có sản phẩm trong đơn hàng này

      //- Nút hành động
      .admin-order-actions-bar.mb-4
        a.btn.btn-secondary(href=`${prefixAdmin}/orders`) ← Quay lại
        if(role.permissions.includes('order_edit'))
          a.btn.btn-warning.ml-2(href=`${prefixAdmin}/orders/edit/${order._id}`)  Chỉnh sửa
        if(role.permissions.includes('order_delete'))
          button.btn.btn-danger.ml-2(
            data-id=order._id
            button-order-delete
          ) Xóa đơn hàng

      form(
        method="POST"
        action=""
        data-path=`${prefixAdmin}/orders/delete`
        form-order-delete
      )

      script(src='/admin/js/order.js')
    else
      .admin-order-empty
        .empty-icon 
        h3 Không tìm thấy đơn hàng
        a.btn.btn-secondary(href=`${prefixAdmin}/orders`) ← Quay lại danh sách
