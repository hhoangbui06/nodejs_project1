extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(5000)

  .row.mt-4
    .col-12
      .card-mb-4
        .card-header Thông tin tài khoản
        .card-body
          if(user.avatar)
            img(src=user.avatar style="height: 100px; margin-bottom: 15px;")
          if(user.fullName)
            p Họ tên: <b>#{user.fullName}</b>
          if(user.email)
            p Email: <b>#{user.email}</b>
          if(user.phone)
            p Số điện thoại: <b>#{user.phone}</b>
          if(role.title)
            p Quyền người dùng: <b>#{role.title}</b>
    .col-6
      .card-mb-4
        .card-header Danh mục sản phẩm
        .card-body
          p Số lượng: <b>#{categoryInfo.total}</b>
          p Hoạt động: <b>#{categoryInfo.active}</b>
          p Dừng hoạt động: <b>#{categoryInfo.inactive}</b>
    .col-6
      .card-mb-4
        .card-header Sản phẩm
        .card-body
          p Số lượng: <b>#{productInfo.total}</b>
          p Hoạt động: <b>#{productInfo.active}</b>
          p Dừng hoạt động: <b>#{productInfo.inactive}</b>
    .col-6
      .card-mb-4
        .card-header Tài khoản admin
        .card-body
          p Số lượng: <b>#{accountInfo.total}</b>
          p Hoạt động: <b>#{accountInfo.active}</b>
          p Dừng hoạt động: <b>#{accountInfo.inactive}</b>
    .col-6
      .card-mb-4
        .card-header Tài khoản client
        .card-body
          p Số lượng: <b>#{userInfo.total}</b>
          p Hoạt động: <b>#{userInfo.active}</b>
          p Dừng hoạt động: <b>#{userInfo.inactive}</b>